root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.go]
indent_style = tab

[{Makefile,*.mk}]
indent_style = tab

[*.{py,cs,csx,csproj,props,targets,sln,slnx}]
indent_size = 4

[*.{rb,gemspec,lua,rockspec,yml,yaml,json,js,mjs,css,html,svg,toml}]
indent_size = 2
